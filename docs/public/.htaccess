# astro-ui.banachwebsolutions.com (static Starlight docs on a mydevil.net PHP-type site).
Options -Indexes
RewriteEngine On

# HTTPS only.
RewriteCond %{HTTPS} off
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Starlight's own 404 page.
ErrorDocument 404 /404.html

# Security headers.
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

# Pages are checked on every visit; files in /_astro/ have a content hash in their name, so they never change.
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/_astro/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
