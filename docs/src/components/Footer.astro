---
// Starlight's footer plus a credit linking to the author's site.
import Default from '@astrojs/starlight/components/Footer.astro';
import { Image } from 'astro:assets';
import logoDark from '../assets/bws-long-light.svg';
import logoLight from '../assets/bws-long.svg';
---

<Default />

<a class="credit" href="https://banachwebsolutions.com">
  <span>Created by</span>
  {/* The navy plate on light pages, the light one on dark pages. */}
  <Image
    src={logoLight}
    alt="Banach Web Solutions"
    class="dark:sl-hidden"
    height={24}
  />
  <Image
    src={logoDark}
    alt="Banach Web Solutions"
    class="light:sl-hidden"
    height={24}
  />
</a>

<style>
  .credit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-block: 2rem 1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .credit:hover {
    color: var(--sl-color-white);
  }
  .credit img {
    width: auto;
    height: 1.5rem;
  }
</style>
