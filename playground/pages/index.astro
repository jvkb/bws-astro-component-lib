---
import '../styles/global.css';
import {
  Avatar,
  Button,
  Checkbox,
  Chip,
  ChipGroup,
  Dialog,
  Form,
  Icon,
  Menu,
  NavigationDrawer,
  NumberInput,
  Select,
  Switch,
  TextInput,
  Textarea,
  ThemeScript,
} from '../../src';
import { required } from '../../src/rules';
import { contactRules } from '../forms/contact';
import {
  Heart,
  MessageCircle,
  ArrowRight,
  Check,
  User,
  House,
  LayoutGrid,
  Mail,
  Menu as MenuIcon,
  Settings,
  LogOut,
  ChevronDown,
  UserRound,
} from '../../src/icons';
import Star from '../assets/star.svg';
import photo from '../assets/avatar.png';
import type {
  ButtonVariant,
  ColorVariant,
  DrawerLocation,
  MenuItem,
  MenuPlacement,
  InputVariant,
  RoundedVariant,
  Size,
  Variant,
} from '../../src/components/types';
import Card from '../../src/components/Card.astro';

const colors: ColorVariant[] = [
  'primary',
  'secondary',
  'success',
  'warning',
  'info',
  'error',
];
const variants: ButtonVariant[] = [
  'elevated',
  'flat',
  'tonal',
  'outlined',
  'text',
];
const sizes: Size[] = ['xs', 'sm', 'default', 'lg', 'xl'];
const roundings: RoundedVariant[] = ['xs', 'sm', 'default', 'lg', 'xl', 'full'];
const inputVariants: InputVariant[] = ['filled', 'outlined', 'underlined'];
const cities = [
  'Warszawa',
  'Kraków',
  'Wrocław',
  'Gdańsk',
  'Poznań',
  'Łódź',
  'Szczecin',
  'Lublin',
  'Katowice',
  'Białystok',
];
const accountItems: MenuItem[] = [
  { title: 'Profile', href: '#', icon: UserRound },
  { title: 'Settings', value: 'settings', icon: Settings },
  { title: 'Billing (soon)', value: 'billing', disabled: true },
  { divider: true },
  { title: 'Log out', value: 'logout', icon: LogOut, color: 'error' },
];
const productItems: MenuItem[] = [
  { title: 'Websites', href: '#' },
  { title: 'Online shops', href: '#' },
  { title: 'SEO', href: '#' },
];
const menuPlacements: MenuPlacement[] = [
  'bottom-end',
  'top-start',
  'right-start',
];
const drawerLocations: DrawerLocation[] = ['left', 'right', 'top', 'bottom'];
const navItems = [
  { title: 'Home', href: '#', icon: House },
  { title: 'Components', href: '#', icon: LayoutGrid },
  { title: 'Contact', href: '#contact-form', icon: Mail },
  { title: 'Settings', href: '#', icon: Settings },
];
const cardVariants: Variant[] = ['elevated', 'flat', 'outlined', 'tonal'];
const chipVariants: ButtonVariant[] = [
  'tonal',
  'flat',
  'elevated',
  'outlined',
  'text',
];
const chipColors: (ColorVariant | undefined)[] = [
  undefined,
  'primary',
  'secondary',
  'success',
  'error',
];
const plans = [
  { title: 'Free', value: 'free' },
  { title: 'Pro — 49 zł / mies.', value: 'pro' },
  { title: 'Enterprise (contact us)', value: 'enterprise', disabled: true },
];

// Full class names so Tailwind can detect them.
const palettes = {
  primary: [
    ['50', 'bg-primary-50'],
    ['100', 'bg-primary-100'],
    ['200', 'bg-primary-200'],
    ['300', 'bg-primary-300'],
    ['400', 'bg-primary-400'],
    ['500', 'bg-primary-500'],
    ['600', 'bg-primary-600'],
    ['700', 'bg-primary-700'],
    ['800', 'bg-primary-800'],
    ['900', 'bg-primary-900'],
    ['950', 'bg-primary-950'],
  ],
  secondary: [
    ['50', 'bg-secondary-50'],
    ['100', 'bg-secondary-100'],
    ['200', 'bg-secondary-200'],
    ['300', 'bg-secondary-300'],
    ['400', 'bg-secondary-400'],
    ['500', 'bg-secondary-500'],
    ['600', 'bg-secondary-600'],
    ['700', 'bg-secondary-700'],
    ['800', 'bg-secondary-800'],
    ['900', 'bg-secondary-900'],
    ['950', 'bg-secondary-950'],
  ],
};
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playground</title>
    <ThemeScript />
  </head>
  <body class="p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-2xl font-bold text-primary">bws-astro-components</h1>
      <div class="flex gap-2" role="group" aria-label="Theme">
        <Button size="sm" variant="outlined" data-set-theme="light">
          Light
        </Button>
        <Button size="sm" variant="outlined" data-set-theme="dark">
          Dark
        </Button>
        <Button size="sm" variant="outlined" data-set-theme="system">
          System
        </Button>
      </div>
    </div>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Themes</h2>
      <div
        data-theme="dark"
        class="grid max-w-5xl grid-cols-3 gap-4 rounded-lg p-6"
      >
        <Card
          title='data-theme="dark"'
          subtitle="A dark section, whatever the page theme"
          text="Every component inside follows it."
        >
          <Fragment slot="actions">
            <Button variant="text">Cancel</Button>
            <Button>Save</Button>
          </Fragment>
        </Card>
        <div class="space-y-2">
          <TextInput
            label="Email"
            variant="outlined"
            hint="Outlined label on the section background"
          />
          <Select label="City" items={cities} />
          <ChipGroup
            items={['Astro', 'Vue', 'React']}
            value="Astro"
            color="success"
            filter
          />
        </div>
        <Card
          data-theme="light"
          title='data-theme="light"'
          subtitle="Nested back to light"
          text="Themes nest both ways."
        >
          <Chip slot="actions" color="info" text="info" />
        </Card>
      </div>
    </section>

    <section class="mt-8 space-y-6">
      <h2 class="text-lg font-semibold">Palette</h2>
      {Object.entries(palettes).map(([name, shades]) => (
        <div>
          <p class="mb-2 text-sm font-medium">{name}</p>
          <div class="grid grid-cols-11 gap-2">
            {shades.map(([step, bg]) => (
              <div>
                <div class:list={['h-12 rounded-md', bg]} />
                <p class="mt-1 text-xs text-on-background/70">{step}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Button</h2>
      <div class="grid grid-cols-[repeat(6,max-content)] items-center gap-3">
        {colors.map((color) => (
          <>
            <p class="text-sm text-on-background/70">{color}</p>
            {variants.map((variant) => (
              <Button color={color} variant={variant}>
                {variant}
              </Button>
            ))}
          </>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        {sizes.map((size) => (
          <Button size={size}>
            {size} <Icon icon={ArrowRight} />
          </Button>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        {roundings.map((rounded) => (
          <Button rounded={rounded} variant="tonal">
            rounded: {rounded}
          </Button>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="#">Link (&lt;a&gt;)</Button>
        <Button variant="tonal" color="secondary">
          Umów spotkanie <Icon icon={ArrowRight} />
        </Button>
        <Button class="rounded-full">Override: rounded-full</Button>
        <Button variant="outlined" class="h-12 px-6 text-base">
          Override: size
        </Button>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <Button block={true} variant="flat">
          Block button (full width)
        </Button>
      </div>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Icon</h2>
      <div class="flex items-end gap-4 text-primary">
        {sizes.map((size) => (
          <Icon icon={Heart} size={size} />
        ))}
        <Icon icon={Heart} size={40} class="text-secondary" />
        <Icon icon={Star} size="xl" label="Ulubione" class="text-secondary" />
      </div>
      <p class="flex items-center gap-2 text-xl">
        Dopasowuje się do tekstu <Icon icon={MessageCircle} />{' '}
        <Icon icon={ArrowRight} stroke-width={3} />
      </p>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">TextInput</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <TextInput variant={variant} label={`${variant}: empty`} />
          <TextInput
            variant={variant}
            label="With value"
            value="Jan Kowalski"
          />
          <TextInput
            variant={variant}
            label="Email"
            type="email"
            hint="We'll never share it"
          />
          <TextInput
            variant={variant}
            label="Email"
            value="jan@"
            error="Enter a valid email address"
          />
          <TextInput
            variant={variant}
            label="With placeholder"
            placeholder="e.g. Warszawa"
            color="secondary"
          />
          <TextInput
            variant={variant}
            label="Disabled"
            value="Read only"
            disabled
          />
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Textarea</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <Textarea variant={variant} label={`${variant}: empty`} rows={3} />
          <Textarea
            variant={variant}
            label="Auto-grow (max 6 rows)"
            rows={2}
            autoGrow
            maxRows={6}
            value="Type more lines here to see the field grow."
          />
          <Textarea
            variant={variant}
            label="With counter"
            rows={3}
            maxlength={120}
            counter
            hint="Counts against maxlength"
          />
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">NumberInput</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <NumberInput
            variant={variant}
            label={`${variant}: 0–10`}
            min={0}
            max={10}
            value={9}
            hint="Hits the max after one step"
          />
          <NumberInput
            variant={variant}
            label="Quantity (split)"
            controlVariant="split"
            min={1}
            value={1}
          />
          <NumberInput
            variant={variant}
            label="Price (step 0.5, hidden)"
            controlVariant="hidden"
            step={0.5}
          />
          <NumberInput
            variant={variant}
            label="Guests"
            value={42}
            max={20}
            error="At most 20 guests"
          />
          <NumberInput variant={variant} label="Disabled" value={3} disabled />
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Select</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <Select
            variant={variant}
            label={`${variant}: city`}
            items={cities}
            hint="Type a letter to jump"
          />
          <Select
            variant={variant}
            label="Plan"
            items={plans}
            value="pro"
            color="secondary"
          />
          <Select
            variant={variant}
            label="With placeholder"
            placeholder="Choose…"
            items={cities}
          />
          <Select
            variant={variant}
            label="Error"
            items={cities}
            error="This city is not available"
          />
          <Select
            variant={variant}
            label="Disabled"
            items={cities}
            value="Kraków"
            disabled
          />
        </div>
      ))}
      <div class="grid max-w-5xl grid-cols-3 items-end gap-4">
        <Select
          variant="outlined"
          label='location="top"'
          items={cities}
          location="top"
          hint="Always opens above"
        />
        <Select
          variant="outlined"
          label='location="bottom"'
          items={cities}
          location="bottom"
          hint="Always opens below"
        />
        <div
          id="overflow-demo"
          class="flex h-40 items-end overflow-hidden rounded-md border border-dashed border-on-background/40 p-3"
        >
          <Select
            class="w-full"
            variant="outlined"
            label="auto, inside overflow-hidden"
            items={cities}
            hint="The list overflows the box instead of being cut off"
          />
        </div>
      </div>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Checkbox</h2>
      <div class="grid max-w-3xl grid-cols-2 gap-x-8 gap-y-2">
        <Checkbox label="Checked" checked />
        <Checkbox label="Unchecked" />
        <Checkbox label="Secondary" color="secondary" checked />
        <Checkbox label="Indeterminate" indeterminate />
        <Checkbox label="Disabled" disabled checked />
        <Checkbox label="With a hint" hint="We'll send one email a month" />
        <Checkbox>
          I accept the{' '}
          <a href="#" class="text-primary underline">
            terms
          </a>
        </Checkbox>
        <Checkbox label="Error" error="This one is required" />
      </div>
      <fieldset id="select-all-demo" class="space-y-1">
        <legend class="mb-1 text-sm font-medium">Select all</legend>
        <Checkbox id="select-all" label="All toppings" indeterminate />
        <div class="space-y-1 pl-7">
          <Checkbox name="toppings" value="cheese" label="Cheese" checked />
          <Checkbox name="toppings" value="ham" label="Ham" />
          <Checkbox name="toppings" value="olives" label="Olives" />
        </div>
      </fieldset>
    </section>

    <script>
      // "Select all": the parent follows its children — checked, unchecked or indeterminate.
      const group = document.getElementById('select-all-demo')!;
      const all = document.getElementById('select-all') as HTMLInputElement;
      const items = [
        ...group.querySelectorAll<HTMLInputElement>('input[name="toppings"]'),
      ];
      all.addEventListener('change', () =>
        items.forEach((item) => (item.checked = all.checked)),
      );
      group.addEventListener('change', (event) => {
        if (event.target === all) return;
        const checked = items.filter((item) => item.checked).length;
        all.checked = checked === items.length;
        all.indeterminate = checked > 0 && checked < items.length;
      });
    </script>
    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Switch</h2>
      <div class="grid max-w-3xl grid-cols-2 gap-x-8 gap-y-2">
        <Switch label="Notifications" checked />
        <Switch label="Notifications (inset)" inset checked />
        <Switch label="Off" />
        <Switch label="Off (inset)" inset />
        <Switch label="Secondary" color="secondary" checked />
        <Switch label="Success, inset" color="success" inset checked />
        <Switch label="Disabled" disabled checked />
        <Switch label="Disabled, inset" inset disabled />
        <Switch label="Dark mode" hint="Applies to every page" />
        <Switch>
          I've read the{' '}
          <a href="#" class="text-primary underline">
            privacy policy
          </a>
        </Switch>
      </div>
    </section>

    <section class="mt-8 mb-16 space-y-4">
      <h2 class="text-lg font-semibold">Form</h2>
      <Form
        id="contact-form"
        class="grid max-w-3xl grid-cols-2 gap-x-4 gap-y-2"
      >
        <TextInput name="name" label="Imię" rules={contactRules.name} />
        <TextInput
          name="email"
          type="email"
          label="Email"
          hint="Odpowiemy na ten adres"
          rules={contactRules.email}
        />
        <TextInput
          name="postalCode"
          label="Kod pocztowy"
          hint="Opcjonalnie"
          rules={contactRules.postalCode}
        />
        <TextInput name="nip" label="NIP" rules={contactRules.nip} />
        <ChipGroup
          class="col-span-2"
          name="services"
          label="Usługi"
          items={['Strona WWW', 'Sklep', 'SEO', 'Hosting']}
          multiple
          filter
          rules={contactRules.services}
        />
        <Select
          name="country"
          label="Kraj"
          items={['Polska', 'Niemcy', 'Czechy', 'Słowacja']}
          rules={contactRules.country}
        />
        <NumberInput
          name="guests"
          label="Liczba gości"
          controlVariant="split"
          rules={contactRules.guests}
        />
        <Textarea
          class="col-span-2"
          name="message"
          label="Wiadomość"
          rows={3}
          autoGrow
          counter
          rules={contactRules.message}
        />
        <TextInput
          name="login"
          label="Login"
          value="admin"
          rules={[required()]}
          error="Ten login jest już zajęty"
        />
        <Switch
          class="col-span-2"
          name="terms"
          label="Akceptuję regulamin"
          rules={contactRules.terms}
        />
        <div class="col-span-2 flex gap-4">
          <Button type="submit">Wyślij</Button>
          <Button type="reset" variant="outlined">
            Wyczyść
          </Button>
        </div>
        <p id="form-result" class="col-span-2 text-sm text-success"></p>
      </Form>
    </section>

    <section class="mt-8 mb-16 space-y-4">
      <h2 class="text-lg font-semibold">Card</h2>
      <div class="grid max-w-5xl grid-cols-3 gap-4 rounded-lg bg-on-background/5 p-6">
        {cardVariants.map((variant) => (
          <Card
            variant={variant}
            title={`${variant[0].toUpperCase()}${variant.slice(1)}`}
            subtitle={`variant="${variant}"`}
            text="Neutral card without a color. The body takes any content through the default slot."
          >
            <Fragment slot="actions">
              <Button variant="text">Cancel</Button>
              <Button variant="text">Save</Button>
            </Fragment>
          </Card>
        ))}
        <Card
          title="Elevated, primary"
          subtitle='color="primary"'
          color="primary"
          text="With a color, elevated and flat cards get a solid background."
        >
          <Button slot="actions" variant="flat" color="secondary">
            Book a call <Icon icon={ArrowRight} />
          </Button>
        </Card>
        <Card
          variant="tonal"
          color="secondary"
          title="Tonal, secondary"
          text="Tonal and outlined cards take the color for the tint, border and text."
        />
        <Card variant="outlined" color="success" rounded="xl">
          <div slot="title" class="flex items-center gap-2">
            <Icon icon={Heart} size="sm" /> Slots everywhere
          </div>
          <Fragment slot="subtitle">
            Title via the <code>title</code> slot
          </Fragment>
          <ul class="list-disc pl-5">
            <li>outlined, color="success"</li>
            <li>rounded="xl"</li>
          </ul>
          <Button slot="actions" variant="outlined" color="success" size="sm">
            Got it
          </Button>
        </Card>
        <Card title="Only a title and actions">
          <Button slot="actions" variant="text">
            Open
          </Button>
        </Card>
        <Card text="Only body text — no header, no actions." variant="flat" />
      </div>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Dialog</h2>
      <div class="flex flex-wrap items-center gap-3">
        <Dialog
          id="delete-dialog"
          title="Delete the project?"
          text="This removes the project and its files. It can't be undone."
          width="sm"
        >
          <Button slot="activator" color="error" variant="tonal">
            Delete…
          </Button>
          <Fragment slot="actions">
            <Button variant="text" data-dialog-close>
              Cancel
            </Button>
            <Button color="error" data-dialog-close>
              Delete
            </Button>
          </Fragment>
        </Dialog>

        <Dialog
          title="Accept the terms"
          text="This dialog is persistent: the backdrop and Escape don't close it — only the buttons do."
          persistent
          closable
        >
          <Button slot="activator" variant="outlined">
            Persistent
          </Button>
          <Button slot="actions" data-dialog-close>
            I agree
          </Button>
        </Dialog>

        <Button variant="tonal" data-dialog-open="terms-dialog">
          Opened by id (long content)
        </Button>

        <Dialog title="Contact us" closable width="sm">
          <Button slot="activator" variant="flat" color="secondary">
            With a form
          </Button>
          <Form method="dialog" class="flex flex-col gap-1">
            <TextInput name="name" label="Name" rules={[required()]} />
            <Textarea
              name="message"
              label="Message"
              rows={3}
              rules={[required()]}
            />
            <div class="flex justify-end gap-2 pt-2">
              <Button variant="text" data-dialog-close>
                Cancel
              </Button>
              <Button type="submit">Send</Button>
            </div>
          </Form>
        </Dialog>

        <Dialog title="Fullscreen" fullscreen closable>
          <Button slot="activator" variant="text">
            Fullscreen
          </Button>
          <p>Takes the whole screen — useful on phones.</p>
        </Dialog>
      </div>

      <Dialog id="terms-dialog" title="Terms of service" width="lg" closable>
        {Array.from({ length: 12 }, (_, i) => (
          <p class="mb-3">
            {i + 1}. Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            Integer nec odio. Praesent libero. Sed cursus ante dapibus diam. Sed
            nisi. Nulla quis sem at nibh elementum imperdiet. Duis sagittis
            ipsum.
          </p>
        ))}
        <Button slot="actions" data-dialog-close>
          Close
        </Button>
      </Dialog>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Menu</h2>
      <div class="flex flex-wrap items-center gap-3">
        <Menu id="account-menu" items={accountItems}>
          <Button slot="activator" variant="outlined">
            Account <Icon icon={ChevronDown} />
          </Button>
        </Menu>
        {menuPlacements.map((location) => (
          <Menu location={location} items={accountItems.slice(0, 2)}>
            <Button slot="activator" variant="tonal">
              {location}
            </Button>
          </Menu>
        ))}
        <Menu openOnHover items={productItems}>
          <Button slot="activator" variant="text">
            Products (hover) <Icon icon={ChevronDown} />
          </Button>
        </Menu>
        <Menu closeOnContentClick={false} location="bottom-end" class="w-72">
          <Button slot="activator" variant="flat" color="secondary">
            Free-form content
          </Button>
          <p class="mb-3 text-sm text-on-surface/70">
            Any content — here a small form. Clicks inside don't close it.
          </p>
          <TextInput label="Coupon code" variant="outlined" />
          <Button class="mt-2" block>
            Apply
          </Button>
        </Menu>
        <div class="h-12 overflow-hidden rounded-md border border-dashed border-on-background/40 p-1">
          <Menu items={accountItems}>
            <Button slot="activator" variant="text" size="sm">
              In overflow: hidden
            </Button>
          </Menu>
        </div>
      </div>
      <p id="menu-log" class="text-sm text-on-background/70">
        Choose an action from Account…
      </p>
    </section>

    <script>
      document
        .getElementById('account-menu')
        ?.addEventListener('menu:select', (event) => {
          const { value, title } = (event as CustomEvent).detail;
          document.getElementById('menu-log')!.textContent =
            `menu:select → value "${value}", title "${title}"`;
        });
    </script>
    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">NavigationDrawer</h2>
      <div class="flex flex-wrap items-center gap-3">
        <NavigationDrawer title="Menu" closable>
          <Button slot="activator" variant="outlined" aria-label="Open menu">
            <Icon icon={MenuIcon} /> Menu
          </Button>
          <ul class="flex flex-col gap-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex items-center gap-3 rounded-md px-3 py-2 text-sm hover:bg-on-surface/8"
                >
                  <Icon icon={item.icon} size="sm" class="text-on-surface/70" />
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
          <div slot="append" class="flex items-center gap-3">
            <Avatar text="JB" color="primary" size="sm" />
            <div class="min-w-0 text-sm">
              <p class="truncate font-medium">Jakub Banach</p>
              <p class="truncate text-on-surface/60">jakub@example.com</p>
            </div>
          </div>
        </NavigationDrawer>
        {drawerLocations.map((location) => (
          <Button variant="tonal" data-drawer-open={`drawer-${location}`}>
            {location}
          </Button>
        ))}
      </div>
      {drawerLocations.map((location) => (
        <NavigationDrawer
          id={`drawer-${location}`}
          location={location}
          title={`location="${location}"`}
          closable
        >
          <p class="px-3 py-2 text-sm text-on-surface/70">
            Slides in from the {location} edge and back out the same way.
          </p>
        </NavigationDrawer>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Avatar</h2>
      <div class="flex flex-wrap items-center gap-3">
        <Avatar image={photo} alt="" label="Jakub Banach" />
        <Avatar
          image="/does-not-exist.png"
          text="JB"
          color="primary"
          label="Broken image falls back to initials"
        />
        <Avatar text="JB" color="primary" />
        <Avatar text="AK" color="secondary" variant="flat" />
        <Avatar icon={User} color="success" />
        <Avatar icon={User} variant="outlined" />
        <Avatar text="MN" color="info" rounded="lg" />
        <Avatar text="99+" color="error" variant="flat" size="sm" />
      </div>
      <div class="flex flex-wrap items-center gap-3">
        {sizes.map((size) => (
          <Avatar size={size} text="JB" color="primary" variant="flat" />
        ))}
        <Avatar size={72} image={photo} alt="" />
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Chip color="primary">
          <Avatar
            slot="prepend"
            size={24}
            text="JB"
            color="primary"
            variant="flat"
            class="-ml-2"
          />
          Jakub Banach
        </Chip>
        <Chip closable>
          <Avatar slot="prepend" size={24} image={photo} alt="" class="-ml-2" />
          With a photo
        </Chip>
      </div>
    </section>

    <section class="mt-8 mb-16 space-y-4">
      <h2 class="text-lg font-semibold">Chip</h2>
      <div class="grid w-max grid-cols-[repeat(6,max-content)] items-center gap-3">
        {chipColors.map((color) => (
          <>
            <p class="text-sm text-on-background/70">{color ?? 'no color'}</p>
            {chipVariants.map((variant) => (
              <Chip color={color} variant={variant} text={variant} />
            ))}
          </>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-3">
        {sizes.map((size) => (
          <Chip size={size} color="primary" prependIcon={Heart} text={size} />
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Chip rounded="sm" color="info" text='rounded="sm" (label)' />
        <Chip
          href="#"
          color="primary"
          appendIcon={ArrowRight}
          text="Link chip"
        />
        <Chip
          href="#"
          variant="outlined"
          color="secondary"
          text="Outlined link"
        />
        <Chip
          variant="outlined"
          color="success"
          prependIcon={Check}
          text="Done"
        />
        <Chip color="primary">
          <span
            slot="prepend"
            class="-ml-2 inline-flex size-6 items-center justify-center rounded-full bg-primary text-[0.625rem] text-on-primary"
          >
            JB
          </span>
          Jakub Banach
        </Chip>
      </div>
      <div id="chip-list" class="flex flex-wrap items-center gap-2">
        <Chip closable text="Astro" />
        <Chip closable color="primary" text="Tailwind" />
        <Chip closable color="secondary" variant="outlined" text="TypeScript" />
        <Chip closable color="error" text="Can't remove me" data-keep />
        <Chip closable color="success" variant="flat" text="Vuetify" />
      </div>
      <p id="chip-log" class="text-sm text-on-background/70"></p>

      <h3 class="pt-4 font-semibold">ChipGroup</h3>
      <div class="grid max-w-5xl grid-cols-2 gap-6">
        <ChipGroup
          label="Single choice (click again to deselect)"
          name="size"
          items={['XS', 'S', 'M', 'L', 'XL']}
          value="M"
        />
        <ChipGroup
          label="Single, mandatory (first chip preselected)"
          name="delivery"
          items={['Kurier', 'Paczkomat', 'Odbiór osobisty']}
          mandatory
          color="secondary"
        />
        <ChipGroup
          label="Multiple with filter"
          name="tags"
          items={['Astro', 'Tailwind', 'TypeScript', 'Vue', 'React']}
          value={['Astro', 'Tailwind']}
          multiple
          filter
        />
        <ChipGroup
          label="Multiple, mandatory, outlined"
          name="days"
          items={[
            { title: 'Pon', value: 'mon' },
            { title: 'Wt', value: 'tue' },
            { title: 'Śr', value: 'wed' },
            { title: 'Sob (closed)', value: 'sat', disabled: true },
          ]}
          value={['mon']}
          multiple
          mandatory
          filter
          variant="outlined"
          color="success"
          hint="Can't uncheck the last day"
        />
      </div>
    </section>

    <script>
      // chip:close is cancelable — the chip with data-keep stays.
      document
        .getElementById('chip-list')
        ?.addEventListener('chip:close', (event) => {
          const chip = event.target as HTMLElement;
          const log = document.getElementById('chip-log')!;
          if (chip.hasAttribute('data-keep')) {
            event.preventDefault();
            log.textContent = 'Kept: the chip:close event was canceled.';
          } else {
            log.textContent = `Removed: ${chip.textContent?.trim()}`;
          }
        });
    </script>
    <script>
      // Registers the custom "nip" rule in the browser.
      import '../forms/contact';

      // Only reached when every field is valid — Form stops the submit otherwise.
      document
        .getElementById('contact-form')
        ?.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = Object.fromEntries(
            new FormData(event.target as HTMLFormElement),
          );
          document.getElementById('form-result')!.textContent =
            `Valid, would send: ${JSON.stringify(data)}`;
        });
    </script>
    <script>
      import { setTheme, type Theme } from '../../src/theme';

      document.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLElement>(
          '[data-set-theme]',
        );
        if (button) setTheme(button.dataset.setTheme as Theme);
      });
    </script>
  </body>
</html>
