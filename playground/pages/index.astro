---
import '../styles/global.css';
import {
  Button,
  Chip,
  Form,
  Icon,
  NumberInput,
  Select,
  TextInput,
} from '../../src';
import { required } from '../../src/rules';
import { contactRules } from '../forms/contact';
import { Heart, MessageCircle, ArrowRight, Check } from '../../src/icons';
import Star from '../assets/star.svg';
import type {
  ButtonVariant,
  ColorVariant,
  InputVariant,
  RoundedVariant,
  Size,
  Variant,
} from '../../src/components/types';
import Card from '../../src/components/Card.astro';

const colors: ColorVariant[] = [
  'primary',
  'secondary',
  'success',
  'warning',
  'info',
  'error',
];
const variants: ButtonVariant[] = [
  'elevated',
  'flat',
  'tonal',
  'outlined',
  'text',
];
const sizes: Size[] = ['xs', 'sm', 'default', 'lg', 'xl'];
const roundings: RoundedVariant[] = ['xs', 'sm', 'default', 'lg', 'xl', 'full'];
const inputVariants: InputVariant[] = ['filled', 'outlined', 'underlined'];
const cities = [
  'Warszawa',
  'Kraków',
  'Wrocław',
  'Gdańsk',
  'Poznań',
  'Łódź',
  'Szczecin',
  'Lublin',
  'Katowice',
  'Białystok',
];
const cardVariants: Variant[] = ['elevated', 'flat', 'outlined', 'tonal'];
const chipVariants: ButtonVariant[] = [
  'tonal',
  'flat',
  'elevated',
  'outlined',
  'text',
];
const chipColors: (ColorVariant | undefined)[] = [
  undefined,
  'primary',
  'secondary',
  'success',
  'error',
];
const plans = [
  { title: 'Free', value: 'free' },
  { title: 'Pro — 49 zł / mies.', value: 'pro' },
  { title: 'Enterprise (contact us)', value: 'enterprise', disabled: true },
];

// Full class names so Tailwind can detect them.
const palettes = {
  primary: [
    ['50', 'bg-primary-50'],
    ['100', 'bg-primary-100'],
    ['200', 'bg-primary-200'],
    ['300', 'bg-primary-300'],
    ['400', 'bg-primary-400'],
    ['500', 'bg-primary-500'],
    ['600', 'bg-primary-600'],
    ['700', 'bg-primary-700'],
    ['800', 'bg-primary-800'],
    ['900', 'bg-primary-900'],
    ['950', 'bg-primary-950'],
  ],
  secondary: [
    ['50', 'bg-secondary-50'],
    ['100', 'bg-secondary-100'],
    ['200', 'bg-secondary-200'],
    ['300', 'bg-secondary-300'],
    ['400', 'bg-secondary-400'],
    ['500', 'bg-secondary-500'],
    ['600', 'bg-secondary-600'],
    ['700', 'bg-secondary-700'],
    ['800', 'bg-secondary-800'],
    ['900', 'bg-secondary-900'],
    ['950', 'bg-secondary-950'],
  ],
};
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playground</title>
  </head>
  <body class="p-8">
    <h1 class="text-2xl font-bold text-primary">bws-astro-components</h1>

    <section class="mt-8 space-y-6">
      <h2 class="text-lg font-semibold">Palette</h2>
      {Object.entries(palettes).map(([name, shades]) => (
        <div>
          <p class="mb-2 text-sm font-medium">{name}</p>
          <div class="grid grid-cols-11 gap-2">
            {shades.map(([step, bg]) => (
              <div>
                <div class:list={['h-12 rounded-md', bg]} />
                <p class="mt-1 text-xs text-gray-600">{step}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Button</h2>
      <div class="grid grid-cols-[repeat(6,max-content)] items-center gap-3">
        {colors.map((color) => (
          <>
            <p class="text-sm text-gray-600">{color}</p>
            {variants.map((variant) => (
              <Button color={color} variant={variant}>
                {variant}
              </Button>
            ))}
          </>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        {sizes.map((size) => (
          <Button size={size}>
            {size} <Icon icon={ArrowRight} />
          </Button>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        {roundings.map((rounded) => (
          <Button rounded={rounded} variant="tonal">
            rounded: {rounded}
          </Button>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="#">Link (&lt;a&gt;)</Button>
        <Button variant="tonal" color="secondary">
          Umów spotkanie <Icon icon={ArrowRight} />
        </Button>
        <Button class="rounded-full">Override: rounded-full</Button>
        <Button variant="outlined" class="h-12 px-6 text-base">
          Override: size
        </Button>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <Button block={true} variant="flat">
          Block button (full width)
        </Button>
      </div>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Icon</h2>
      <div class="flex items-end gap-4 text-primary">
        {sizes.map((size) => (
          <Icon icon={Heart} size={size} />
        ))}
        <Icon icon={Heart} size={40} class="text-secondary" />
        <Icon icon={Star} size="xl" label="Ulubione" class="text-secondary" />
      </div>
      <p class="flex items-center gap-2 text-xl">
        Dopasowuje się do tekstu <Icon icon={MessageCircle} />{' '}
        <Icon icon={ArrowRight} stroke-width={3} />
      </p>
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">TextInput</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <TextInput variant={variant} label={`${variant}: empty`} />
          <TextInput
            variant={variant}
            label="With value"
            value="Jan Kowalski"
          />
          <TextInput
            variant={variant}
            label="Email"
            type="email"
            hint="We'll never share it"
          />
          <TextInput
            variant={variant}
            label="Email"
            value="jan@"
            error="Enter a valid email address"
          />
          <TextInput
            variant={variant}
            label="With placeholder"
            placeholder="e.g. Warszawa"
            color="secondary"
          />
          <TextInput
            variant={variant}
            label="Disabled"
            value="Read only"
            disabled
          />
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">NumberInput</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <NumberInput
            variant={variant}
            label={`${variant}: 0–10`}
            min={0}
            max={10}
            value={9}
            hint="Hits the max after one step"
          />
          <NumberInput
            variant={variant}
            label="Quantity (split)"
            controlVariant="split"
            min={1}
            value={1}
          />
          <NumberInput
            variant={variant}
            label="Price (step 0.5, hidden)"
            controlVariant="hidden"
            step={0.5}
          />
          <NumberInput
            variant={variant}
            label="Guests"
            value={42}
            max={20}
            error="At most 20 guests"
          />
          <NumberInput variant={variant} label="Disabled" value={3} disabled />
        </div>
      ))}
    </section>

    <section class="mt-8 space-y-4">
      <h2 class="text-lg font-semibold">Select</h2>
      {inputVariants.map((variant) => (
        <div class="grid max-w-5xl grid-cols-3 items-start gap-4">
          <Select
            variant={variant}
            label={`${variant}: city`}
            items={cities}
            hint="Type a letter to jump"
          />
          <Select
            variant={variant}
            label="Plan"
            items={plans}
            value="pro"
            color="secondary"
          />
          <Select
            variant={variant}
            label="With placeholder"
            placeholder="Choose…"
            items={cities}
          />
          <Select
            variant={variant}
            label="Error"
            items={cities}
            error="This city is not available"
          />
          <Select
            variant={variant}
            label="Disabled"
            items={cities}
            value="Kraków"
            disabled
          />
        </div>
      ))}
      <div class="grid max-w-5xl grid-cols-3 items-end gap-4">
        <Select
          variant="outlined"
          label='location="top"'
          items={cities}
          location="top"
          hint="Always opens above"
        />
        <Select
          variant="outlined"
          label='location="bottom"'
          items={cities}
          location="bottom"
          hint="Always opens below"
        />
        <div
          id="overflow-demo"
          class="flex h-40 items-end overflow-hidden rounded-md border border-dashed border-gray-400 p-3"
        >
          <Select
            class="w-full"
            variant="outlined"
            label="auto, inside overflow-hidden"
            items={cities}
            hint="The list overflows the box instead of being cut off"
          />
        </div>
      </div>
    </section>

    <section class="mt-8 mb-16 space-y-4">
      <h2 class="text-lg font-semibold">Form</h2>
      <Form
        id="contact-form"
        class="grid max-w-3xl grid-cols-2 gap-x-4 gap-y-2"
      >
        <TextInput name="name" label="Imię" rules={contactRules.name} />
        <TextInput
          name="email"
          type="email"
          label="Email"
          hint="Odpowiemy na ten adres"
          rules={contactRules.email}
        />
        <TextInput
          name="postalCode"
          label="Kod pocztowy"
          hint="Opcjonalnie"
          rules={contactRules.postalCode}
        />
        <TextInput name="nip" label="NIP" rules={contactRules.nip} />
        <Select
          name="country"
          label="Kraj"
          items={['Polska', 'Niemcy', 'Czechy', 'Słowacja']}
          rules={contactRules.country}
        />
        <NumberInput
          name="guests"
          label="Liczba gości"
          controlVariant="split"
          rules={contactRules.guests}
        />
        <TextInput
          name="login"
          label="Login"
          value="admin"
          rules={[required()]}
          error="Ten login jest już zajęty"
        />
        <div class="col-span-2 flex gap-4">
          <Button type="submit">Wyślij</Button>
          <Button type="reset" variant="outlined">
            Wyczyść
          </Button>
        </div>
        <p id="form-result" class="col-span-2 text-sm text-success"></p>
      </Form>
    </section>

    <section class="mt-8 mb-16 space-y-4">
      <h2 class="text-lg font-semibold">Card</h2>
      <div class="grid max-w-5xl grid-cols-3 gap-4 rounded-lg bg-gray-100 p-6">
        {cardVariants.map((variant) => (
          <Card
            variant={variant}
            title={`${variant[0].toUpperCase()}${variant.slice(1)}`}
            subtitle={`variant="${variant}"`}
            text="Neutral card without a color. The body takes any content through the default slot."
          >
            <Fragment slot="actions">
              <Button variant="text">Cancel</Button>
              <Button variant="text">Save</Button>
            </Fragment>
          </Card>
        ))}
        <Card
          title="Elevated, primary"
          subtitle='color="primary"'
          color="primary"
          text="With a color, elevated and flat cards get a solid background."
        >
          <Button slot="actions" variant="flat" color="secondary">
            Book a call <Icon icon={ArrowRight} />
          </Button>
        </Card>
        <Card
          variant="tonal"
          color="secondary"
          title="Tonal, secondary"
          text="Tonal and outlined cards take the color for the tint, border and text."
        />
        <Card variant="outlined" color="success" rounded="xl">
          <div slot="title" class="flex items-center gap-2">
            <Icon icon={Heart} size="sm" /> Slots everywhere
          </div>
          <Fragment slot="subtitle">
            Title via the <code>title</code> slot
          </Fragment>
          <ul class="list-disc pl-5">
            <li>outlined, color="success"</li>
            <li>rounded="xl"</li>
          </ul>
          <Button slot="actions" variant="outlined" color="success" size="sm">
            Got it
          </Button>
        </Card>
        <Card title="Only a title and actions">
          <Button slot="actions" variant="text">
            Open
          </Button>
        </Card>
        <Card text="Only body text — no header, no actions." variant="flat" />
      </div>
    </section>

    <section class="mt-8 mb-16 space-y-4">
      <h2 class="text-lg font-semibold">Chip</h2>
      <div class="grid w-max grid-cols-[repeat(6,max-content)] items-center gap-3">
        {chipColors.map((color) => (
          <>
            <p class="text-sm text-gray-600">{color ?? 'no color'}</p>
            {chipVariants.map((variant) => (
              <Chip color={color} variant={variant} text={variant} />
            ))}
          </>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-3">
        {sizes.map((size) => (
          <Chip size={size} color="primary" prependIcon={Heart} text={size} />
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Chip rounded="sm" color="info" text='rounded="sm" (label)' />
        <Chip
          href="#"
          color="primary"
          appendIcon={ArrowRight}
          text="Link chip"
        />
        <Chip
          href="#"
          variant="outlined"
          color="secondary"
          text="Outlined link"
        />
        <Chip
          variant="outlined"
          color="success"
          prependIcon={Check}
          text="Done"
        />
        <Chip color="primary">
          <span
            slot="prepend"
            class="-ml-2 inline-flex size-6 items-center justify-center rounded-full bg-primary text-[0.625rem] text-white"
          >
            JB
          </span>
          Jakub Banach
        </Chip>
      </div>
      <div id="chip-list" class="flex flex-wrap items-center gap-2">
        <Chip closable text="Astro" />
        <Chip closable color="primary" text="Tailwind" />
        <Chip closable color="secondary" variant="outlined" text="TypeScript" />
        <Chip closable color="error" text="Can't remove me" data-keep />
        <Chip closable color="success" variant="flat" text="Vuetify" />
      </div>
      <p id="chip-log" class="text-sm text-gray-600"></p>
    </section>

    <script>
      // chip:close is cancelable — the chip with data-keep stays.
      document
        .getElementById('chip-list')
        ?.addEventListener('chip:close', (event) => {
          const chip = event.target as HTMLElement;
          const log = document.getElementById('chip-log')!;
          if (chip.hasAttribute('data-keep')) {
            event.preventDefault();
            log.textContent = 'Kept: the chip:close event was canceled.';
          } else {
            log.textContent = `Removed: ${chip.textContent?.trim()}`;
          }
        });
    </script>
    <script>
      // Registers the custom "nip" rule in the browser.
      import '../forms/contact';

      // Only reached when every field is valid — Form stops the submit otherwise.
      document
        .getElementById('contact-form')
        ?.addEventListener('submit', (event) => {
          event.preventDefault();
          const data = Object.fromEntries(
            new FormData(event.target as HTMLFormElement),
          );
          document.getElementById('form-result')!.textContent =
            `Valid, would send: ${JSON.stringify(data)}`;
        });
    </script>
  </body>
</html>
