---
import type { HTMLAttributes } from 'astro/types';
import { twMerge } from 'tailwind-merge';
import type {
  ButtonVariant,
  ColorVariant,
  RoundedVariant,
  SharedProps,
  Size,
} from './types.ts';

type OwnProps = {
  variant?: ButtonVariant;
  color?: ColorVariant;
  size?: Size;
  block?: boolean;
  rounded?: RoundedVariant;
} & SharedProps;

// With `href` the component renders a link and takes <a> attributes, otherwise <button> attributes.
type Props = OwnProps &
  (
    | (Omit<HTMLAttributes<'a'>, keyof OwnProps> & { href: string })
    | (Omit<HTMLAttributes<'button'>, keyof OwnProps> & { href?: undefined })
  );

const props = Astro.props;
// Component-only props stay out of the spread, so they don't end up as HTML attributes.
const {
  block,
  variant,
  color,
  size,
  rounded,
  class: _class,
  type,
  ...attrs
} = props;

// `type` is set once, outside the spread: Astro would render it twice and the browser keeps the first.
// A <button> defaults to type="submit" — default to "button" so it never submits a form by accident.
const buttonType = (type ?? 'button') as HTMLAttributes<'button'>['type'];

// Shared by every variant. Every variant has a 1px border (transparent unless outlined), so all of them are the same size.
// Dimensions live in getButtonSize, corner radius in getButtonRounded.
const base =
  'inline-flex cursor-pointer items-center justify-center border font-medium ' +
  'transition-[color,background-color,border-color,box-shadow] duration-150 ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--btn-color) ' +
  'disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50';

// Variants only describe the shape; the color comes from --btn-color (see getButtonColor).
// Hover/active states and the tonal background are that color at reduced opacity, like Vuetify's overlays.
function getClassesBasedOnVariant(variant: ButtonVariant) {
  switch (variant) {
    case 'flat': {
      return 'border-transparent bg-(--btn-color) text-white hover:bg-(--btn-color)/90 active:bg-(--btn-color)/80';
    }
    case 'elevated': {
      return 'border-transparent bg-(--btn-color) text-white shadow-md hover:bg-(--btn-color)/90 hover:shadow-lg active:bg-(--btn-color)/80 active:shadow-sm';
    }
    case 'outlined': {
      return 'border-(--btn-color) text-(--btn-color) hover:bg-(--btn-color)/8 active:bg-(--btn-color)/16';
    }
    case 'text': {
      return 'border-transparent text-(--btn-color) hover:bg-(--btn-color)/8 active:bg-(--btn-color)/16';
    }
    case 'tonal': {
      return 'border-transparent bg-(--btn-color)/12 text-(--btn-color) hover:bg-(--btn-color)/20 active:bg-(--btn-color)/28';
    }
  }
}

function getButtonColor(color: ColorVariant) {
  switch (color) {
    case 'primary': {
      return '[--btn-color:var(--color-primary)]';
    }
    case 'secondary': {
      return '[--btn-color:var(--color-secondary)]';
    }
    case 'success': {
      return '[--btn-color:var(--color-success)]';
    }
    case 'warning': {
      return '[--btn-color:var(--color-warning)]';
    }
    case 'info': {
      return '[--btn-color:var(--color-info)]';
    }
    case 'error': {
      return '[--btn-color:var(--color-error)]';
    }
  }
}

// Icons inside default to 1em, so they follow the text size of each step.
function getButtonSize(size: Size) {
  switch (size) {
    case 'xs': {
      return 'h-7 gap-1 px-2.5 text-xs';
    }
    case 'sm': {
      return 'h-8 gap-1.5 px-3 text-sm';
    }
    case 'default': {
      return 'h-10 gap-2 px-4 text-sm';
    }
    case 'lg': {
      return 'h-12 gap-2 px-6 text-base';
    }
    case 'xl': {
      return 'h-14 gap-2.5 px-8 text-lg';
    }
  }
}

function getButtonRounded(rounded: RoundedVariant) {
  switch (rounded) {
    case 'xs': {
      return 'rounded-xs';
    }
    case 'sm': {
      return 'rounded-sm';
    }
    case 'default': {
      return 'rounded-md';
    }
    case 'lg': {
      return 'rounded-lg';
    }
    case 'xl': {
      return 'rounded-xl';
    }
    case 'full': {
      return 'rounded-full';
    }
  }
}

// twMerge drops default classes that conflict with ones passed from outside,
// so e.g. class="rounded-full" replaces rounded-md instead of fighting over CSS order.
function getClasses() {
  const cls = [
    base,
    getButtonColor(color ?? 'primary'),
    getClassesBasedOnVariant(variant ?? 'elevated'),
    getButtonSize(size ?? 'default'),
    getButtonRounded(rounded ?? 'default'),
    props.class,
  ];

  if (props.block === true) {
    cls.unshift('w-full');
  }

  return twMerge(...cls);
}
---

{props.href !== undefined ? (
  <a type={type} class={getClasses()} {...attrs}>
    <slot />
  </a>
) : (
  <button type={buttonType} class={getClasses()} {...attrs}>
    <slot />
  </button>
)}
