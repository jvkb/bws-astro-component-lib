---
import type { HTMLAttributes } from 'astro/types';
import { twMerge } from 'tailwind-merge';
import { customColorStyle, isThemeColor, joinStyles } from './color.ts';
import type {
  Color,
  ColorVariant,
  RoundedVariant,
  SharedProps,
  Variant,
} from './types.ts';

type Props = Omit<HTMLAttributes<'div'>, 'class' | 'id' | 'title'> &
  SharedProps & {
    /** Title text; use the `title` slot for richer content. */
    title?: string;
    /** Smaller, muted line under the title; or the `subtitle` slot. */
    subtitle?: string;
    /** Body text; use the default slot for any other content. */
    text?: string;
    variant?: Variant;
    /**
     * Without a color the card is neutral (the theme's surface). A theme color, a Tailwind color
     * (`white`, `red-500`), a hex code or any CSS color.
     */
    color?: Color;
    rounded?: RoundedVariant;
    /** Element for the title — pick the heading level that fits the page outline. */
    titleTag?: 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'div';
  };

const props = Astro.props;
// Component-only props stay out of the spread, so they don't end up as HTML attributes.
const {
  title,
  subtitle,
  text,
  variant,
  color,
  rounded,
  titleTag,
  class: _class,
  style,
  ...attrs
} = props;

const TitleTag = titleTag ?? 'div';
const hasTitle = title !== undefined || Astro.slots.has('title');
const hasSubtitle = subtitle !== undefined || Astro.slots.has('subtitle');
const hasHeader = hasTitle || hasSubtitle;
// What the default slot actually renders: MDX can pass an empty one, which would hide the text prop.
const slotted = Astro.slots.has('default')
  ? (await Astro.slots.render('default')).trim()
  : '';
const hasBody = text !== undefined || slotted !== '';
const hasActions = Astro.slots.has('actions');

function getCardColor(color: ColorVariant) {
  switch (color) {
    case 'primary': {
      return '[--card-color:var(--color-primary)] [--card-on-color:var(--color-on-primary)]';
    }
    case 'secondary': {
      return '[--card-color:var(--color-secondary)] [--card-on-color:var(--color-on-secondary)]';
    }
    case 'success': {
      return '[--card-color:var(--color-success)] [--card-on-color:var(--color-on-success)]';
    }
    case 'warning': {
      return '[--card-color:var(--color-warning)] [--card-on-color:var(--color-on-warning)]';
    }
    case 'info': {
      return '[--card-color:var(--color-info)] [--card-on-color:var(--color-on-info)]';
    }
    case 'error': {
      return '[--card-color:var(--color-error)] [--card-on-color:var(--color-on-error)]';
    }
  }
}

// Like Vuetify: with a color, elevated/flat get a solid background and outlined/tonal take the color
// for the border/tint and the text. Without one, the card stays neutral.
function getClassesBasedOnVariant(variant: Variant, hasColor: boolean) {
  switch (variant) {
    case 'elevated': {
      return hasColor
        ? 'bg-(--card-color) text-(--card-on-color) shadow-md'
        : 'bg-surface shadow-md [--input-bg:var(--color-surface)]';
    }
    case 'flat': {
      return hasColor
        ? 'bg-(--card-color) text-(--card-on-color)'
        : 'bg-surface [--input-bg:var(--color-surface)]';
    }
    case 'outlined': {
      return hasColor
        ? 'border border-(--card-color) text-(--card-color)'
        : 'border border-on-surface/12 bg-surface [--input-bg:var(--color-surface)]';
    }
    case 'tonal': {
      return hasColor
        ? 'bg-(--card-color)/12 text-(--card-color)'
        : 'bg-on-surface/5';
    }
  }
}

function getCardRounded(rounded: RoundedVariant) {
  switch (rounded) {
    case 'xs': {
      return 'rounded-xs';
    }
    case 'sm': {
      return 'rounded-sm';
    }
    case 'default': {
      return 'rounded-md';
    }
    case 'lg': {
      return 'rounded-lg';
    }
    case 'xl': {
      return 'rounded-xl';
    }
    case 'full': {
      return 'rounded-full';
    }
  }
}

// Theme colors are classes (getCardColor); any other color is set inline.
const colorStyle = customColorStyle('card', color);
const colored = isThemeColor(color) || colorStyle !== undefined;
---

<div
  class={twMerge(
    'flex flex-col text-on-surface',
    isThemeColor(color) && getCardColor(color),
    getClassesBasedOnVariant(variant ?? 'elevated', colored),
    getCardRounded(rounded ?? 'default'),
    props.class,
  )}
  style={joinStyles(colorStyle, style)}
  {...attrs}
>
  {hasHeader && (
    <div class="px-4 pt-4 pb-2">
      {hasTitle && (
        <TitleTag class="text-xl leading-snug font-medium">
          <slot name="title">{title}</slot>
        </TitleTag>
      )}
      {hasSubtitle && (
        <div class="mt-0.5 text-sm opacity-70">
          <slot name="subtitle">{subtitle}</slot>
        </div>
      )}
    </div>
  )}
  {hasBody && (
    <div
      class={twMerge(
        'flex-1 px-4 pb-4 text-sm leading-relaxed',
        hasHeader ? 'pt-2' : 'pt-4',
      )}
    >
      {slotted ? <Fragment set:html={slotted} /> : text}
    </div>
  )}
  {hasActions && (
    // mt-auto keeps the actions at the bottom when cards in a grid stretch to the same height.
    <div class="mt-auto flex flex-wrap items-center gap-2 p-2">
      <slot name="actions" />
    </div>
  )}
</div>
