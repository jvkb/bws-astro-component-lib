---
import X from '@lucide/astro/icons/x';
import type { ComponentProps, HTMLAttributes } from 'astro/types';
import { twMerge } from 'tailwind-merge';
import Icon from './Icon.astro';
import type {
  ButtonVariant,
  ColorVariant,
  RoundedVariant,
  SharedProps,
  Size,
} from './types.ts';

type IconComponent = ComponentProps<typeof Icon>['icon'];

type OwnProps = {
  /** Chip text; or use the default slot. */
  text?: string;
  variant?: ButtonVariant;
  /** Without a color the chip is neutral gray. */
  color?: ColorVariant;
  size?: Size;
  rounded?: RoundedVariant;
  /** Icon before the text; use the `prepend` slot for anything else (e.g. an avatar). */
  prependIcon?: IconComponent;
  /** Icon after the text; or the `append` slot. */
  appendIcon?: IconComponent;
} & SharedProps;

// With `href` the chip is a link; otherwise it can be `closable`. Both at once would put a button
// inside a link, which isn't valid HTML.
type Props = OwnProps &
  (
    | (Omit<HTMLAttributes<'a'>, keyof OwnProps> & {
        href: string;
        closable?: never;
      })
    | (Omit<HTMLAttributes<'span'>, keyof OwnProps> & {
        href?: undefined;
        /** Adds a × button that removes the chip (cancel it through the `chip:close` event). */
        closable?: boolean;
        /** Accessible name of the × button. */
        closeLabel?: string;
      })
  );

const props = Astro.props;
// Component-only props stay out of the spread, so they don't end up as HTML attributes.
const {
  text,
  variant,
  color,
  size,
  rounded,
  prependIcon,
  appendIcon,
  closable,
  closeLabel,
  class: _class,
  ...attrs
} = props as OwnProps & {
  closable?: boolean;
  closeLabel?: string;
  href?: string;
};

const Tag = attrs.href !== undefined ? 'a' : 'span';
const interactive = attrs.href !== undefined;

// Every variant has a 1px border (transparent unless outlined), so all of them are the same size.
const base =
  'inline-flex max-w-full shrink-0 items-center border align-middle font-medium whitespace-nowrap';

function getChipColor(color: ColorVariant | undefined) {
  switch (color) {
    case 'primary': {
      return '[--chip-color:var(--color-primary)]';
    }
    case 'secondary': {
      return '[--chip-color:var(--color-secondary)]';
    }
    case 'success': {
      return '[--chip-color:var(--color-success)]';
    }
    case 'warning': {
      return '[--chip-color:var(--color-warning)]';
    }
    case 'info': {
      return '[--chip-color:var(--color-info)]';
    }
    case 'error': {
      return '[--chip-color:var(--color-error)]';
    }
    case undefined: {
      return '[--chip-color:var(--color-gray-700)]';
    }
  }
}

// Same idea as Button: variants describe the shape, the color comes from --chip-color.
function getClassesBasedOnVariant(variant: ButtonVariant) {
  switch (variant) {
    case 'tonal': {
      return 'border-transparent bg-(--chip-color)/12 text-(--chip-color)';
    }
    case 'flat': {
      return 'border-transparent bg-(--chip-color) text-white';
    }
    case 'elevated': {
      return 'border-transparent bg-(--chip-color) text-white shadow-sm';
    }
    case 'outlined': {
      return 'border-(--chip-color) text-(--chip-color)';
    }
    case 'text': {
      return 'border-transparent text-(--chip-color)';
    }
  }
}

// Hover/focus states only for link chips.
function getInteractiveClasses(variant: ButtonVariant) {
  const focus =
    'cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--chip-color)';
  switch (variant) {
    case 'tonal': {
      return `${focus} hover:bg-(--chip-color)/20`;
    }
    case 'flat':
    case 'elevated': {
      return `${focus} hover:bg-(--chip-color)/90`;
    }
    case 'outlined':
    case 'text': {
      return `${focus} hover:bg-(--chip-color)/8`;
    }
  }
}

// Icons default to 1em, so they follow the text size of each step.
function getChipSize(size: Size) {
  switch (size) {
    case 'xs': {
      return 'h-5 gap-1 px-2 text-[0.625rem]';
    }
    case 'sm': {
      return 'h-6 gap-1 px-2.5 text-xs';
    }
    case 'default': {
      return 'h-8 gap-1.5 px-3 text-sm';
    }
    case 'lg': {
      return 'h-9 gap-2 px-4 text-base';
    }
    case 'xl': {
      return 'h-11 gap-2 px-5 text-lg';
    }
  }
}

function getChipRounded(rounded: RoundedVariant) {
  switch (rounded) {
    case 'xs': {
      return 'rounded-xs';
    }
    case 'sm': {
      return 'rounded-sm';
    }
    case 'default': {
      return 'rounded-md';
    }
    case 'lg': {
      return 'rounded-lg';
    }
    case 'xl': {
      return 'rounded-xl';
    }
    case 'full': {
      return 'rounded-full';
    }
  }
}

const currentVariant = variant ?? 'tonal';
---

<Tag
  data-chip
  class={twMerge(
    base,
    getChipColor(color),
    getClassesBasedOnVariant(currentVariant),
    interactive && getInteractiveClasses(currentVariant),
    getChipSize(size ?? 'default'),
    getChipRounded(rounded ?? 'full'),
    props.class,
  )}
  {...attrs}
>
  <slot name="prepend">
    {prependIcon && <Icon icon={prependIcon} class="-ml-0.5" />}
  </slot>
  <span class="truncate">
    <slot>{text}</slot>
  </span>
  <slot name="append">
    {appendIcon && <Icon icon={appendIcon} class="-mr-0.5" />}
  </slot>
  {closable && (
    <button
      type="button"
      data-chip-close
      aria-label={closeLabel ?? 'Remove'}
      class="-mr-1.5 inline-flex size-[1.4em] cursor-pointer items-center justify-center rounded-full opacity-70 hover:bg-current/15 hover:opacity-100 focus-visible:outline-2 focus-visible:outline-current"
    >
      <X class="size-[0.95em]" aria-hidden="true" />
    </button>
  )}
</Tag>

<script>
  // One delegated listener serves every closable Chip on the page (Astro bundles this script once).
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest(
      '[data-chip-close]',
    );
    const chip = button?.closest<HTMLElement>('[data-chip]');
    if (!chip) return;

    // Cancelable, so a page can keep the chip (or remove it itself, e.g. after a request).
    const allowed = chip.dispatchEvent(
      new CustomEvent('chip:close', { bubbles: true, cancelable: true }),
    );
    if (!allowed) return;

    // Move focus to the next (or previous) chip's × button, so keyboard users don't lose their place.
    const buttons = [
      ...(chip.parentElement?.querySelectorAll<HTMLElement>(
        '[data-chip-close]',
      ) ?? []),
    ];
    const index = buttons.indexOf(button as HTMLElement);
    const next = buttons[index + 1] ?? buttons[index - 1];
    chip.remove();
    next?.focus();
  });
</script>
