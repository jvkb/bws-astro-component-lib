---
import X from '@lucide/astro/icons/x';
import type { HTMLAttributes } from 'astro/types';
import { twMerge } from 'tailwind-merge';
import type { SharedProps, Size } from './types.ts';

type Props = Omit<HTMLAttributes<'dialog'>, 'class' | 'id' | 'title' | 'open'> &
  SharedProps & {
    /** Title text; use the `title` slot for richer content. */
    title?: string;
    /** Body text; use the default slot for any other content. */
    text?: string;
    /** Width step or pixels. It never gets wider than the screen. */
    width?: Size | number;
    /** Fill the whole screen. */
    fullscreen?: boolean;
    /** Clicking the backdrop or pressing Escape doesn't close the dialog. */
    persistent?: boolean;
    /** Adds a × button in the corner. */
    closable?: boolean;
    /** Accessible name of the × button. */
    closeLabel?: string;
    /** Open as soon as the page loads. */
    open?: boolean;
    /** Element for the title. */
    titleTag?: 'h2' | 'h3' | 'h4' | 'div';
  };

const props = Astro.props;
// Component-only props stay out of the spread, so they don't end up as HTML attributes.
const {
  title,
  text,
  width,
  fullscreen,
  persistent,
  closable,
  closeLabel,
  open,
  titleTag,
  class: _class,
  id: _id,
  ...attrs
} = props;

const id = props.id ?? `dialog-${crypto.randomUUID().slice(0, 8)}`;
const titleId = `${id}-title`;
const TitleTag = titleTag ?? 'h2';

const hasActivator = Astro.slots.has('activator');
const hasTitle = title !== undefined || Astro.slots.has('title');
// What the default slot actually renders: MDX can pass an empty one, which would hide the text prop.
const slotted = Astro.slots.has('default')
  ? (await Astro.slots.render('default')).trim()
  : '';
const hasBody = text !== undefined || slotted !== '';
const hasActions = Astro.slots.has('actions');

const widths: Record<Size, string> = {
  xs: '20rem',
  sm: '24rem',
  default: '32rem',
  lg: '42rem',
  xl: '56rem',
};
const maxWidth =
  typeof width === 'number' ? `${width}px` : widths[width ?? 'default'];
// Inline, so any pixel width works; min() keeps a margin on small screens.
const widthStyle = fullscreen
  ? undefined
  : `width:min(${maxWidth}, 100vw - 2rem);`;

// Fades and scales in and out. @starting-style (starting:) and allow-discrete (transition-discrete)
// animate the switch to and from display: none; browsers without them just show and hide it.
const animation =
  'opacity-0 scale-95 transition-[opacity,scale,display,overlay] transition-discrete duration-200 ease-out open:opacity-100 open:scale-100 starting:open:opacity-0 starting:open:scale-95 ' +
  'backdrop:bg-black/50 backdrop:opacity-0 backdrop:transition-[opacity,display,overlay] backdrop:transition-discrete backdrop:duration-200 open:backdrop:opacity-100 starting:open:backdrop:opacity-0';
---

{hasActivator && (
  // display: contents — the wrapper only catches the click, it doesn't affect the layout.
  <span class="contents" data-dialog-open={id}>
    <slot name="activator" />
  </span>
)}

<dialog
  id={id}
  data-modal
  data-dialog
  data-persistent={persistent ? '' : undefined}
  data-open={open ? '' : undefined}
  aria-labelledby={hasTitle ? titleId : undefined}
  class={twMerge(
    'm-auto flex-col border-0 bg-surface p-0 text-on-surface shadow-2xl open:flex',
    fullscreen
      ? 'h-dvh max-h-none w-screen max-w-none rounded-none'
      : 'max-h-[calc(100dvh-2rem)] max-w-none rounded-xl',
    animation,
    props.class,
  )}
  style={widthStyle}
  {...attrs}
>
  {closable && (
    <button
      type="button"
      data-dialog-close
      aria-label={closeLabel ?? 'Close'}
      class="absolute top-3 right-3 inline-flex size-9 cursor-pointer items-center justify-center rounded-full text-on-surface/70 hover:bg-on-surface/8 hover:text-on-surface focus-visible:outline-2 focus-visible:outline-primary"
    >
      <X class="size-5" aria-hidden="true" />
    </button>
  )}
  {hasTitle && (
    <div class:list={['px-6 pt-6 pb-2', closable && 'pr-14']}>
      <TitleTag id={titleId} class="text-xl leading-snug font-medium">
        <slot name="title">{title}</slot>
      </TitleTag>
    </div>
  )}
  {hasBody && (
    // The body scrolls when it's long; title and actions stay in place.
    <div
      class:list={[
        'min-h-0 flex-1 overflow-y-auto px-6 pb-4 text-sm leading-relaxed text-on-surface/80',
        hasTitle ? 'pt-2' : 'pt-6',
      ]}
    >
      {slotted ? <Fragment set:html={slotted} /> : text}
    </div>
  )}
  {hasActions && (
    <div class="flex flex-wrap items-center justify-end gap-2 px-4 pt-2 pb-4">
      <slot name="actions" />
    </div>
  )}
</dialog>

<script>
  // Opening, closing, `persistent` and the scroll lock are shared with NavigationDrawer.
  import { setupModals } from './modal.ts';

  setupModals();
</script>
