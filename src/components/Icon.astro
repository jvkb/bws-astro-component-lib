---
import type { AstroComponent as LucideIcon, LucideProps } from '@lucide/astro';
import type { HTMLAttributes, SvgComponent } from 'astro/types';
import { isThemeColor, joinStyles, toCssColor } from './color.ts';
import type { Color, Size } from './types.ts';

// Lucide types these attributes more strictly (no `null`), so they come from LucideProps.
type StrictAttributes = 'color' | 'stroke-width' | 'class' | 'title';

type Props = Omit<
  HTMLAttributes<'svg'>,
  StrictAttributes | 'width' | 'height'
> &
  Pick<LucideProps, Exclude<StrictAttributes, 'color'>> & {
    /** A Lucide icon (`bws-astro-ui/icons`) or an imported `.svg` file. */
    icon: LucideIcon | SvgComponent;
    /** Size step or pixels. Without it the icon follows the current font size (1em), e.g. inside a Button. */
    size?: Size | number;
    /** Accessible name. Without it the icon is treated as decorative and hidden from screen readers. */
    label?: string;
    /**
     * A theme color, a Tailwind color (`white`, `red-500`), a hex code or any CSS color. Without it
     * the icon takes the text color.
     */
    color?: Color;
  };

const sizes: Record<Size, string> = {
  xs: 'size-3',
  sm: 'size-4',
  default: 'size-5',
  lg: 'size-6',
  xl: 'size-8',
};

const {
  icon: Component,
  size,
  label,
  class: className,
  color,
  style,
  ...rest
} = Astro.props;

// Set as the CSS color (the icon draws in currentColor): an SVG attribute can't hold var().
const cssColor =
  color === undefined
    ? undefined
    : isThemeColor(color)
      ? `var(--color-${color})`
      : toCssColor(color);

const sizeClass =
  size === undefined
    ? 'size-[1em]'
    : typeof size === 'number'
      ? undefined
      : sizes[size];
const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

<Component
  width={typeof size === 'number' ? size : undefined}
  height={typeof size === 'number' ? size : undefined}
  class:list={['shrink-0', sizeClass, className]}
  style={joinStyles(cssColor && `color: ${cssColor}`, style)}
  {...a11y}
  {...rest}
/>
