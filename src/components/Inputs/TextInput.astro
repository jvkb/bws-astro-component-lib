---
import type { HTMLAttributes } from 'astro/types';
import { twMerge } from 'tailwind-merge';
import type { ColorVariant, InputVariant, SharedProps } from '../types.ts';

type Props = Omit<HTMLAttributes<'input'>, 'class' | 'id' | 'color'> &
  SharedProps & {
    label?: string;
    variant?: InputVariant;
    color?: ColorVariant;
    /** Helper text under the field. */
    hint?: string;
    /** Error message. When set, the field is marked invalid and shown in the error color. */
    error?: string;
  };

const props = Astro.props;
// Component-only props stay out of the spread, so they don't end up as HTML attributes.
const {
  label,
  variant,
  color,
  hint,
  error,
  class: _class,
  id: _id,
  placeholder,
  type,
  ...attrs
} = props;

// The label and the message need ids to be linked to the input.
const inputId = props.id ?? `text-input-${crypto.randomUUID().slice(0, 8)}`;
const messageId = `${inputId}-message`;
const message = error ?? hint;

// The floating label is pure CSS: it rests inside the field while the input is empty and not focused,
// detected with :placeholder-shown. A single-space placeholder makes that work without a real one.
const inputPlaceholder = label && !placeholder ? ' ' : placeholder;

function getInputColor(color: ColorVariant) {
  switch (color) {
    case 'primary': {
      return '[--input-color:var(--color-primary)]';
    }
    case 'secondary': {
      return '[--input-color:var(--color-secondary)]';
    }
    case 'success': {
      return '[--input-color:var(--color-success)]';
    }
    case 'warning': {
      return '[--input-color:var(--color-warning)]';
    }
    case 'info': {
      return '[--input-color:var(--color-info)]';
    }
    case 'error': {
      return '[--input-color:var(--color-error)]';
    }
  }
}

// filled/underlined get Vuetify's underline that grows from the middle on focus (the ::after line).
function getFieldClasses(variant: InputVariant) {
  switch (variant) {
    case 'filled': {
      return 'rounded-t-md border-b border-gray-500 bg-gray-100 hover:border-gray-900 hover:bg-gray-200 after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:scale-x-0 after:bg-(--input-color) after:transition-transform after:duration-200 focus-within:after:scale-x-100';
    }
    case 'underlined': {
      return 'border-b border-gray-500 hover:border-gray-900 after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:scale-x-0 after:bg-(--input-color) after:transition-transform after:duration-200 focus-within:after:scale-x-100';
    }
    case 'outlined': {
      return 'rounded-md border border-gray-400 hover:border-gray-900 focus-within:border-(--input-color) focus-within:ring-1 focus-within:ring-(--input-color) focus-within:ring-inset';
    }
  }
}

function getErrorFieldClasses(variant: InputVariant) {
  switch (variant) {
    case 'filled':
    case 'underlined': {
      return 'after:scale-x-100';
    }
    case 'outlined': {
      return 'border-(--input-color) hover:border-(--input-color)';
    }
  }
}

function getInputPadding(variant: InputVariant) {
  switch (variant) {
    case 'filled': {
      return label ? 'px-4 pt-5 pb-1' : 'px-4';
    }
    case 'underlined': {
      return label ? 'pt-5 pb-1' : '';
    }
    case 'outlined': {
      return 'px-4';
    }
  }
}

function getLabelClasses(variant: InputVariant) {
  switch (variant) {
    case 'filled': {
      return 'left-4 top-2';
    }
    case 'underlined': {
      return 'left-0 top-2';
    }
    case 'outlined': {
      // Floated onto the border; the background covers the line behind the text (override with --input-bg).
      return 'left-3 top-0 -translate-y-1/2 bg-[var(--input-bg,white)] px-1';
    }
  }
}

// Moves the label back into the field while it's empty and not focused.
// Skipped when there's a real placeholder — the label then stays floated above it.
function getRestingLabelClasses(variant: InputVariant) {
  switch (variant) {
    case 'filled':
    case 'underlined': {
      return 'peer-[:placeholder-shown:not(:focus)]:top-1/2 peer-[:placeholder-shown:not(:focus)]:-translate-y-1/2 peer-[:placeholder-shown:not(:focus)]:text-base';
    }
    case 'outlined': {
      return 'peer-[:placeholder-shown:not(:focus)]:top-1/2 peer-[:placeholder-shown:not(:focus)]:bg-transparent peer-[:placeholder-shown:not(:focus)]:text-base';
    }
  }
}

const currentVariant = variant ?? 'filled';
---

<div
  class={twMerge(
    'flex flex-col gap-1 has-disabled:opacity-60',
    getInputColor(error ? 'error' : (color ?? 'primary')),
    props.class,
  )}
>
  <div
    class={twMerge(
      'relative h-14',
      getFieldClasses(currentVariant),
      error && getErrorFieldClasses(currentVariant),
    )}
  >
    <input
      id={inputId}
      type={type ?? 'text'}
      placeholder={inputPlaceholder}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={message ? messageId : undefined}
      class={twMerge(
        'peer h-full w-full bg-transparent text-base text-gray-900 outline-none placeholder:text-gray-500 disabled:cursor-not-allowed',
        getInputPadding(currentVariant),
      )}
      {...attrs}
    />
    {label && (
      <label
        for={inputId}
        class={twMerge(
          'pointer-events-none absolute text-xs text-gray-600 transition-all duration-150 peer-focus:text-(--input-color)',
          getLabelClasses(currentVariant),
          !placeholder && getRestingLabelClasses(currentVariant),
          error && 'text-(--input-color)',
        )}
      >
        {label}
      </label>
    )}
  </div>
  {message && (
    <p
      id={messageId}
      class={twMerge(
        'text-xs text-gray-600',
        currentVariant !== 'underlined' && 'px-4',
        error && 'text-error',
      )}
    >
      {message}
    </p>
  )}
</div>
